{
  "name": "@antv/aimapui",
  "version": "0.4.3",
  "type": "module",
  "description": "Schema/DSL-driven React map visualization component library powered by L7",
  "main": "dist/index.cjs",
  "module": "dist/index.es.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.es.js"
    },
    "./style.css": "./dist/style.css",
    "./dist/style.css": "./dist/style.css",
    "./dist/index.css": "./dist/style.css",
    "./dist/index.iife.js": "./dist/index.iife.js"
  },
  "unpkg": "./dist/index.iife.js",
  "jsdelivr": "./dist/index.iife.js",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf dist && vite build && vite build --config vite.config.cjs.ts && vite build --config vite.config.iife.ts && rm -f dist/aimapui.css",
    "build:esm": "vite build",
    "build:cjs": "vite build --config vite.config.cjs.ts",
    "build:iife": "vite build --config vite.config.iife.ts",
    "type-check": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@antv/l7": "2.29.0",
    "@antv/l7-maps": "2.29.0",
    "ahooks": "^3.8.4",
    "clsx": "^2.1.1",
    "geotiff": "^3.0.5",
    "h3-js": "^4.4.0",
    "supercluster": "^8.0.1"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.2",
    "@tailwindcss/vite": "^4.0.0",
    "@types/geojson": "^7946.0.16",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/supercluster": "^7.1.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.3.0",
    "vitest": "^4.1.8"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/antvis/aimapui",
    "directory": "packages/core"
  },
  "keywords": [
    "antv",
    "l7",
    "map",
    "visualization",
    "react",
    "schema",
    "dsl",
    "geo"
  ]
}
