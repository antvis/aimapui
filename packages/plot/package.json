{
  "name": "@antv/aimapui-plot",
  "version": "0.3.0",
  "type": "module",
  "description": "Tactical plot/bindtype component for @antv/aimapui — bindtype, bindtype, bindtype, bindtype arrows",
  "main": "dist/index.cjs",
  "module": "dist/index.es.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.es.js"
    },
    "./style.css": "./dist/style.css"
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "rm -rf dist && vite build && vite build --config vite.config.cjs.ts",
    "build:esm": "vite build",
    "build:cjs": "vite build --config vite.config.cjs.ts",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@antv/aimapui": ">=0.3.0",
    "@antv/l7": ">=2.20.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@antv/aimapui": "workspace:*",
    "@antv/l7": "2.28.13",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.3.0",
    "vitest": "^4.1.8"
  },
  "publishConfig": { "access": "public" },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/antvis/aimapui",
    "directory": "packages/plot"
  },
  "keywords": ["antv", "l7", "map", "bindtype", "bindtype", "bindtype", "bindtype", "bindtype", "bindtype"]
}
